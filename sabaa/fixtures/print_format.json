  "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %} \r\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\r\n\r\n\r\n<style>\r\n    .pf-color { color: {{ color }}; }\r\n    .pf-heading { font-size: 20px; font-weight: bold; margin-bottom: 10px; }\r\n    .pf-table { width: 100%; border-collapse: collapse; margin-top: 10px; }\r\n    .pf-table th, .pf-table td { border: 2px solid {{ color }}; padding: 6px; vertical-align: top; }\r\n    .pf-table th { background-color: {{ color }}; color: white; text-align: center; }\r\n    .pf-table td { text-align: center; }\r\n    .pf-font-size { font-size: 15px; }\r\n    .pf-summary td { padding: 4px 6px; }\r\n</style>\r\n\r\n<div class=\"pf-font\">\r\n    \r\n    {% if letter_head %}\r\n        {{ letter_head }}\r\n    {% endif %}\r\n    \r\n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\r\n    \r\n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\r\n        <tbody>\r\n            <tr>\r\n                <td class=\"pf-color\" style=\"width: 50%;\">\r\n                    <p>Number # الرقم</p>\r\n                </td>\r\n                <td style=\"width: 50%;\">\r\n                    <p>{{doc.name}}</p>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"pf-color\" style=\"width: 50%;\">\r\n                    <p>Posting Date تاريخ</p>\r\n                </td>\r\n                <td style=\"width: 50%;\">\r\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n    \r\n    <table class=\"pf-item-table pf-font-size pf-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:5%;\">No.<br>م</th>\r\n                <th style=\"width:15%;\">Date<br>التاريخ</th>\r\n                <th style=\"width:35%;\">Account<br>الحساب</th>\r\n                <th style=\"width:25%;\">Remarks<br>الملاحظات</th>\r\n                <th style=\"width:20%;\">Debit<br>القيمة المدينة</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for account in doc.accounts %}\r\n            <tr>\r\n                <td>{{ account.idx }}</td>\r\n                <td>{{ account.get_formatted(\"expense_date\") or \"\" }}</td>\r\n                <td style=\"text-align:left;\">\r\n                    <div><b>Account:</b> {{ account.expense_account }}</div>\r\n                    {% if account.project %}\r\n                        <div style=\"border-top:1px dashed #ccc;\"><b>Project:</b> {{ frappe.db.get_value(\"Project\", account.project, \"project_name\") }}</div>\r\n                    {% endif %}\r\n                    {% if account.cost_center %}\r\n                        <div style=\"border-top:1px dashed #ccc;\"><b>Cost Center:</b> {{ account.cost_center }}</div>\r\n                    {% endif %}\r\n                    {% if account.ref_no %}\r\n                        <div style=\"border-top:1px dashed #ccc;\"><b>Ref:</b> {{ account.ref_no }}</div>\r\n                    {% endif %}\r\n                </td>\r\n                <td>{{ account.notes }}</td>\r\n                <td>{{ account.get_formatted(\"amount\", doc) }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <br>\r\n    \r\n    <table class=\"pf-font-size\" style=\"width: 100%;\">\r\n        <tr>\r\n            <td style=\"width: 70%;\"></td>\r\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\r\n                  Total: {{doc.company_currency}} {{ doc.total_expense }} \r\n            </td>\r\n        </tr>\r\n        <tr></tr>\r\n        <tr>\r\n            <td style=\"width: 70%;\"></td>\r\n            <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\r\n                {{ frappe.utils.money_in_words(doc.total_expense,'SYP','Syrian Pounds') }}\r\n\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    <table class=\"pf-font-size\" style=\"width: 100%;\">\r\n        <tr>\r\n            <td rowspan=\"3\" style=\"width: 20%;\">\r\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.name }}&size=120x120\">\r\n            </td>\r\n            <td style=\"width: 10%;\"></td>\r\n            <td style=\"width: 30%; vertical-align: middle!important;\">\r\n                Mode of Payment طريقة الدفع:\r\n            </td>\r\n            <td style=\"width: 45%; vertical-align: middle!important;\">\r\n                <b>{{doc.mode_of_payment}}</b>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td></td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n                Paid From حساب الدفع:\r\n            </td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n                <b> {{ doc.mode_of_payment_account }} </b>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td></td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n                Cost Center مركز التكلفة:\r\n            </td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n                <b> {{doc.cost_center}}</b> \r\n            </td>     \r\n        </tr>\r\n        \r\n        <tr>\r\n            <td rowspan=\"3\" ></td>\r\n            <td style=\"width: 10%;\"></td>\r\n            <td  style=\"vertical-align: middle!important;\">\r\n               Project المشروع:\r\n            </td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n              <b> {{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") }} </b>\r\n            </td>     \r\n        </tr>\r\n        <tr>\r\n            <td style=\"width: 10%;\"></td>\r\n            <td rowspan=\"3\" style=\"vertical-align: middle!important;\">\r\n                Remarks الملاحظات:\r\n            </td>\r\n            <td style=\"vertical-align: middle!important;\">\r\n               <b> {{ doc.remarks }} </b> \r\n            </td>     \r\n        </tr>\r\n\r\n</table>\r\n    \r\n{% if footer %}\r\n\t<div class=\"text-center footer small\">\r\n\t\t    {{footer}}\r\n\t</div>\r\n{% endif %}\r\n    \r\n</div>\r\n",
