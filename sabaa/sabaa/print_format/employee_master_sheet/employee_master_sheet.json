{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-03-26 18:25:12.369444",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Employee",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    .print-format, .print-format table{\r\n        font-size:11px !important;\r\n    }\r\n    \r\n    input[type=checkbox] + label {\r\n        display:none;\r\n    }\r\n    \r\n    input[type=checkbox]:checked + label {\r\n        height: 16px;\r\n        width: 16px;\r\n        display:inline-block;\r\n        padding: 0 0 0 0px;\r\n        margin-bottom:0px;\r\n    }\r\n    \r\n    .print-format .emp-info tr:nth-child(even){\r\n        background-color: #F0F8FF !important;\r\n    }\r\n\r\n    .print-format .emp-info tr:nth-child(odd) {\r\n        background-color: #fff!important;\r\n    }\r\n</style>\r\n\r\n{% if letter_head %}\r\n\t{{letter_head}}\r\n{% endif %}\r\n\r\n{% set today_date = frappe.utils.getdate(frappe.utils.today()) %}\r\n\r\n<h1 class=\"text-center\" style=\"width: 100%; padding: 10px 0 0 0; margin: 0 auto 20px; font-weight: bold;\">EMPLOYEE MASTER SHEET</h1>\r\n<!--<h6 style=\"display:flex;align-items:end;\">-->\r\n<!--    <span style=\"font-weight:bold;\">{{ doc.name }}</span>-->\r\n<!--    <input style = \"\" type=\"checkbox\" {%if doc.status==\"Active\"%} checked {%endif%}>-->\r\n<!--    <label style:\"margin-bottom:0px;\">\u2714</label>-->\r\n<!--    <span style=\"font-weight:bold;\">Valid</span>-->\r\n<!--</h6>-->\r\n    \r\n<table class=\"emp-info\" width=\"100%\" style=\"text-align:center; margin-bottom:16px\">\r\n    \r\n    <tr style=\"font-weight:bold;\">\r\n        <td>Employee ID / \u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u0638\u0641</td>\r\n        <td>Full Name / \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644</td>\r\n        <td>Status / \u0627\u0644\u062d\u0627\u0644\u0629</td>\r\n        <td rowspan=3 style=\"padding:0px 60px !important;\">{%if doc.image%}<img style=\"width:180px; height:100px; margin-top:-20px;\" src=\"{{doc.image}}\"/>{%endif%}</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>{{doc.name}}</td>\r\n        <td>{{_(doc.employee_name)}}</td>\r\n        <td>{{_(doc.status)}}</td>\r\n    </tr>\r\n    \r\n     <tr style=\"font-weight:bold\">\r\n        <td>Date of Birth / \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0644\u0627\u062f\u0629 </td>\r\n        <td>Date of Joining / \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645</td>\r\n        <td>Date of Rejoining / \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0648\u062f\u0629</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>{{frappe.utils.formatdate(doc.date_of_birth)}}</td>\r\n        <td>{{frappe.utils.formatdate(doc.date_of_joining)}}</td>\r\n        <td>{{frappe.utils.formatdate(doc.custom_return_from_vacation)}}</td>\r\n    </tr>\r\n    \r\n    <tr style=\"font-weight:bold\">\r\n        <td>Nationality / \u0627\u0644\u062c\u0646\u0633\u064a\u0629</td>\r\n        <td>Passport Number / \u0631\u0642\u0645 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631</td>\r\n        <td>QID Number / \u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 </td>\r\n        <td>Employee Type /\u0646\u0648\u0639 \u0627\u0644\u062a\u0648\u0638\u064a\u0641</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td> {{doc.nationality }} / {{ doc.nationality_ar }} </td>\r\n        <td>\r\n            {{doc.passport_number}}\r\n            {% if doc.valid_upto and frappe.utils.getdate(doc.valid_upto) > today_date %}\r\n                <span style=\"color: green; font-weight:bold;\"> Valid </span>\r\n            {% elif doc.passport_number %}\r\n                <span style=\"color: red; font-weight:bold;\"> Expired </span>\r\n            {% endif %}\r\n        </td>\r\n        <td>\r\n            {{doc.custom_employee_qid }}\r\n            {% if doc.qid_expiry and frappe.utils.getdate(doc.qid_expiry) > today_date %}\r\n                <span style=\"color: green; font-weight:bold;\"> Valid </span>\r\n            {% elif doc.custom_employee_qid %}\r\n                <span style=\"color: red; font-weight:bold;\"> Expired </span>\r\n            {% endif %}\r\n        </td>\r\n        \r\n       \r\n        <td>{{_(doc.employment_type)}}</td>\r\n    </tr>\r\n    \r\n    <tr style=\"font-weight:bold\">\r\n        <td>Mobile Number / \u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641</td>\r\n        <td>Place of Work / \u0645\u0643\u0627\u0646 \u0627\u0644\u0639\u0645\u0644</td>\r\n        <td>Designation / \u0627\u0644\u0645\u0633\u0645\u064e\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a</td>\r\n        <td>Department / \u0627\u0644\u0642\u0633\u0645</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>{{doc.cell_number}}</td>\r\n        <td> {{ doc.place_of_work }} / {{doc.place_of_work_ar }} </td>\r\n        <td>{{_(doc.designation)}}</td>\r\n        <td>{{ doc.department }}</td>\r\n    </tr>\r\n    \r\n     <tr style=\"font-weight:bold\">\r\n        <td>Exit Permit Required / </td>\r\n        <td>50% End of Service Benefit Paid / \u062f\u0641\u0639 50% \u0645\u0646 \u0641\u0627\u0626\u062f\u0629 \u0627\u0644\u062e\u062f\u0645\u0629</td>\r\n        <td>Hiring Source / \u0645\u0635\u062f\u0631 \u0627\u0644\u062a\u0648\u0638\u064a\u0641</td>\r\n        <td>Last Air Ticket Paid By Company /  \u062f\u0641\u0639 \u0622\u062e\u0631 \u062a\u0630\u0643\u0631\u0629 \u0637\u064a\u0631\u0627\u0646 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0643\u0629</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n        <td>{% if doc.exit_permit_required %}Yes {% else %}No {% endif %}</td>\r\n        <td> {% if doc.end_of_service_benefit_paid %}Yes {% else %}No {% endif %}</td>\r\n        <td>{{ doc.hiring_source }}</td>\r\n        <td>{% if doc.last_air_ticket_paid_by_company %}Yes {% else %}No {% endif %}</td>\r\n    </tr>\r\n    \r\n    <!--<tr>-->\r\n    <!--    <td colspan=\"4\">-->\r\n    <!--        <div style=\"display:flex;justify-content:space-between;align-items:end\">-->\r\n    <!--            <div><b>Educational Qualification / \u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u064a\u0629</b></div>-->\r\n    <!--            {%if doc.education | length > 0%}-->\r\n    <!--                {% set qualification_list = {\"value\": []} %}-->\r\n    <!--                {%for row in doc.education%}-->\r\n    <!--                    {% set _ = qualification_list.value.append(row.qualification) %}-->\r\n    <!--                {%endfor%}-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\" {%if \"Degree\" in qualification_list.value %} checked {%endif%}><label>\u2714</label>Degree</div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\" {%if \"Diploma\" in qualification_list.value %} checked {%endif%}><label>\u2714</label>Diploma </div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\" {%if \"Secondary\" in qualification_list.value %} checked {%endif%}><label>\u2714</label>Secondary</div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\" {%if \"Degree\" not in qualification_list.value and  \"Diploma\" not in qualification_list.value and \"Secondary\" not in qualification_list.value %} checked {%endif%}><label>\u2714</label>Others(Specify)</div>-->\r\n    <!--            {%else%}-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\">Degree/\u0634\u0647\u0627\u062f\u0629 \u062c\u0627\u0645\u0639\u064a\u0629 </div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\">Diploma/\u062f\u064a\u0628\u0644\u0648\u0645\u0627</div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\">Secondary/\u0634\u0647\u0627\u062f\u0629 \u062b\u0627\u0646\u0648\u064a\u0629</div>-->\r\n    <!--                <div style=\"display:flex;align-items:end\"><input type=\"checkbox\">Others(Specify)/(\u0622\u062e\u0631(\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u062f\u064a\u062f</div>-->\r\n    <!--            {%endif%}-->\r\n                \r\n    <!--        </div>-->\r\n    <!--    </td>-->\r\n    <!--</tr>-->\r\n    \r\n</table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Educational Qualification / \u0627\u0644\u0645\u0624\u0647\u0644\u0627\u062a \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u064a\u0629  </h5>\r\n\r\n<table width=\"100%\" style=\"text-align:center;margin-bottom:16px\">\r\n    <tr style=\"font-weight:bold;\">\r\n        <td style=\"border:1px dashed black\">Qualification /  \u0627\u0644\u0645\u0624\u0647\u0644</td>\r\n        <td style=\"border:1px dashed black\">School/University / \u0627\u0644\u0645\u062f\u0631\u0633\u0629/\u0627\u0644\u062c\u0627\u0645\u0639\u0629</td>\r\n        <td style=\" border:1px dashed black\">Year of Passing / \u0633\u0646\u0629 \u0627\u0644\u062a\u062e\u0631\u062c</td>\r\n    </tr>\r\n    {% for degree in doc.education %}\r\n        <tr>\r\n            <td style=\"border:1px dashed black\">{{ degree.qualification }}</td>\r\n            <td style=\"border:1px dashed black\">{{ degree.school_univ }}</td>\r\n            <td style=\"border:1px dashed black\">{{ degree.year_of_passing }}</td>\r\n        </tr>\r\n    {% endfor %}\r\n    {% if doc.education == [] %}\r\n            <tr>\r\n            <td style=\"border:1px dashed black\">None</td>\r\n            <td style=\"border:1px dashed black\"></td>\r\n            <td style=\"border:1px dashed black\"></td>\r\n        </tr>\r\n    {% endif %}\r\n    </table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Emergency Contact Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 </h5>\r\n<table width=\"100%\" style=\"text-align:center;margin-bottom:16px\">\r\n    <tr style=\"font-weight:bold;\">\r\n        <td style=\"border:1px dashed black\">Name / \u0627\u0644\u0627\u0633\u0645</td>\r\n        <td style=\"border:1px dashed black\">Relation / \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629</td>\r\n        <td style=\"border:1px dashed black\">Tel./Mobile No./Email / \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0648\u0627\u0635\u0644</td>\r\n        <td style=\"border:1px dashed black\">Address/Place of Stay / \u0645\u0643\u0627\u0646 \u0627\u0644\u0625\u0642\u0627\u0645\u0629</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px dashed black\">{{doc.person_to_be_contacted}}</td>\r\n        <td style=\"border:1px dashed black\">{{doc.relation or \"\"}}</td>\r\n        <td style=\"border:1px dashed black\">{{doc.emergency_phone_number or \"\"}}</td>\r\n        <td style=\"border:1px dashed black\">{{doc.current_address or \"\"}}</td>\r\n    </tr>\r\n</table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Salary Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0631\u0627\u062a\u0628</h5>\r\n{% set base = frappe.db.get_value(\"Salary Structure Assignment\" , {\"employee\" : doc.name} , \"base\") or 0%}\r\n{% set accom = frappe.db.get_value(\"Salary Structure Assignment\" , {\"employee\" : doc.name} , \"custom_accommodation_allowance\") or 0%}\r\n{% set other = frappe.db.get_value(\"Salary Structure Assignment\" , {\"employee\" : doc.name} , \"custom_other_allowance\") or 0 %}\r\n{% set total = base + accom + other%}\r\n\r\n<table width=\"100%\" style=\"border:1px solid black;margin-bottom:16px\">\r\n    <tr>\r\n        <td style=\"font-weight:bold;\">Basic Salary / \u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a</td>\r\n        <td style=\"text-align:center\">{{base}}</td>\r\n        <td></td>\r\n        <td></td>\r\n    </tr>\r\n     <tr>\r\n        <td style=\"font-weight:bold;\">Accommodation / \u0627\u0644\u0625\u0642\u0627\u0645\u0629</td>\r\n        <td style=\"text-align:center\">{{accom}}</td>\r\n        <td><span style=\"font-weight:bold;\">Provided by Company / \u0645\u0642\u062f\u0645\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0634\u0631\u0643\u0629:</span> {% if accom > 0 %} NO {% else %} YES {% endif %}</td>\r\n        <td></td>\r\n    </tr>\r\n     <tr>\r\n        <td style=\"font-weight:bold;\">Other Allowance / \u0625\u062a\u0627\u062d\u0627\u062a \u0623\u062e\u0631\u0649</td>\r\n        <td style=\"text-align:center\">{{other}}</td>\r\n        <td></td>\r\n        <td></td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"font-weight:bold;\">Total Salary(QR) / \u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0643\u0627\u0645\u0644 \u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u0627\u0644\u0642\u0637\u0631\u064a</td>\r\n        <td style=\"text-align:center\">{{total}}</td>\r\n        <td></td>\r\n        <td></td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"font-weight:bold;\">In Words / \u0643\u062a\u0627\u0628\u0629 </td>\r\n        <td style=\"text-align:center\">{{frappe.utils.money_in_words(total)}}</td>\r\n        <td></td>\r\n        <td></td>\r\n    </tr>\r\n</table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Leave Balance Summary / \u0645\u0644\u062e\u0635 \u0631\u0635\u064a\u062f \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a</h5>\r\n\r\n{% set results = fetch_leave_balance(doc.name) %}\r\n<table width=\"100%\" style=\"border:1px solid black;margin-bottom:16px\">\r\n    {% for leave in results %}\r\n        <tr>\r\n            <td style=\"font-weight:bold;\">{{ leave[\"leave_type\"] }}</td>\r\n            <td style=\"text-align:left\">{{ leave[\"balance\"] }}</td>\r\n        </tr>\r\n    {% endfor %}\r\n</table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Driver Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0633\u0627\u0626\u0642</h5>\r\n<table width=\"100%\" style=\"text-align:center;margin-bottom:16px\">\r\n    <tr style=\"font-weight:bold;\">\r\n        <td style=\"border:1px dashed black\">Driving License / \u0631\u062e\u0635\u0629 \u0627\u0644\u0633\u0627\u0626\u0642</td>\r\n        <td style=\"border:1px dashed black\">Issue Date /  \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631</td>\r\n        <td style=\"border:1px dashed black\">Expiry Date /  \u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px dashed black\">{{doc.driving_license}}</td>\r\n        <td style=\"border:1px dashed black\">{{frappe.utils.formatdate(doc.driving_license_issue_date)}}</td>\r\n        <td style=\"border:1px dashed black\">\r\n            {{frappe.utils.formatdate(doc.driving_license_expiry_date)}}\r\n            {% if doc.driving_license_expiry_date and frappe.utils.getdate(doc.driving_license_expiry_date) > today_date %}\r\n                <span style=\"color: green; font-weight:bold;\"> Valid </span>\r\n            {% elif doc.driving_license %}\r\n                <span style=\"color: red; font-weight:bold;\"> Expired </span>\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n</table>\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic\">Vehicle Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0629</h5>\r\n<table width=\"100%\" style=\"text-align:center;margin-bottom:16px\">\r\n    <tr style=\"font-weight:bold;\">\r\n        <td style=\"border:1px dashed black\">License Plate / \u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u0631\u062e\u064a\u0635</td>\r\n        <td style=\"border:1px dashed black\">Make /  \u0627\u0644\u0635\u0646\u0639</td>\r\n        <td style=\"border:1px dashed black\">Model / \u0627\u0644\u0646\u0645\u0648\u0630\u062c</td>\r\n        <td style=\"border:1px dashed black\">Type / \u0627\u0644\u0646\u0648\u0639</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px dashed black\">{{doc.license_plate}}</td>\r\n        <td style=\"border:1px dashed black\">{{doc.vehicle_make}}</td>\r\n        <td style=\"border:1px dashed black\">{{doc.vehicle_model}}</td>\r\n        <td style=\"border:1px dashed black\">{{ _(doc.vehicle_type) }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<h5 style=\"font-weight:bold;text-decoration:underline; font-style:italic;\">Health Insurance Details / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u062d\u064a</h5>\r\n<h6 style=\"display:flex;align-items:end;\">\r\n    {%if doc.insured %}\r\n    <!--<input style = \"\" type=\"checkbox\" checked>-->\r\n    <!--<label style:\"margin-bottom:0px; color:green;\">\u2714</label>-->\r\n    <span style=\"color:green; font-weight: 500;\">Is Insured / \u0645\u0624\u0645\u0646\r\n    </span> {% else %}\r\n    <span style=\"color: red; font-weight:500;\">Not Insured / \u063a\u064a\u0631 \u0645\u0624\u0645\u0646\r\n    </span>{% endif %}\r\n</h6>\r\n\r\n<table width=\"100%\" style=\"text-align:center;margin-bottom:16px\">\r\n    <tr style=\"font-weight:bold;\">\r\n        <td style=\"border:1px dashed black\"> Health Certificate / \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0635\u062d\u064a\u0629</td>\r\n            \r\n        <td style=\"border:1px dashed black\">Issue Date /  \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631</td>\r\n        <td style=\"border:1px dashed black\">Expiry Date /  \u062a\u0627\u0631\u064a\u062e \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629</td>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px dashed black\">{{doc.health_insurance_provider}}</td>\r\n        <td style=\"border:1px dashed black\">{{frappe.utils.formatdate(doc.health_certificate_issue_date)}}</td>\r\n        <td style=\"border:1px dashed black\">\r\n            {{frappe.utils.formatdate(doc.health_insurance_expiry)}}\r\n            {% if doc.health_insurance_expiry and frappe.utils.getdate(doc.health_insurance_expiry) > today_date %}\r\n                <span style=\"color: green; font-weight:bold;\"> Valid </span>\r\n            {% elif doc.is_insured %}\r\n                <span style=\"color: red; font-weight:bold;\"> Expired </span>\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<p>I HEREBY CERTIFY that the information provided in this form is complete, true and correct to the best of my knowledge.</p>\r\n\r\n<table style=\"margin-top:16px\">\r\n    <tr>\r\n        <td style=\"font-weight:bold;\">Employee Signature / \u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0648\u0638\u0641 : ______________________________________</td>\r\n        <td style=\"text-align:right\"><span style=\"font-weight:bold;\">Date / \u0627\u0644\u062a\u0627\u0631\u064a\u062e : </span>{{frappe.utils.nowdate()}}</td>\r\n    </tr>\r\n</table>\r\n\r\n{% set hr = frappe.db.get_value(\"Comment\", {\"reference_name\": doc.name, \"content\": \"Waiting for Approval\"}, \"comment_email\") %}\r\n{% set hr_sign = frappe.db.get_value(\"User\", hr, \"user_signature\") %}\r\n\r\n{% set gm_manager = frappe.db.get_value(\"Comment\", {\"reference_name\": doc.name, \"content\": \"Approved\"}, \"comment_email\") %}\r\n{% set gm_manager_sign = frappe.db.get_value(\"User\", gm_manager, \"user_signature\") %}\r\n\r\n<table style=\"width: 100%;margin-top:32px\">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td  style=\"text-align: center;font-weight: bold\">HR Executive / \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a</td>\r\n\t\t\t<td  style=\"text-align: center;font-weight: bold\">General Manager / \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0639\u0627\u0645 </td>\r\n\t\t</tr>\r\n\r\n\t\t<tr>\r\n\t\t\t<td  style=\"text-align: center;\">{% if hr_sign %}<br><img style=\"max-width:80%\" src=\"{{hr_sign}}\" width=\"80\">{% endif %}</td>\r\n\t\t\t<td  style=\"text-align: center;\">{% if gm_manager_sign %}<br><img style=\"max-width:60%\" src=\"{{gm_manager_sign}}\" width=\"80\">{% endif %}</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n\r\n</div>",
